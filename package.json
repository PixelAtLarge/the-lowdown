{
  "name": "@pixelatlarge/the-lowdown",
  "version": "0.2.0",
  "description": "Give your AI agent the lowdown: a short guided Q&A that writes a design brief (users, goals, constraints, tone) for agents to follow.",
  "keywords": [
    "the-lowdown",
    "design-brief",
    "project-brief",
    "ai-agents",
    "agents-md",
    "claude-code",
    "prompt",
    "ux",
    "design",
    "cli",
    "react"
  ],
  "author": "Anna Poirier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelAtLarge/the-lowdown.git"
  },
  "homepage": "https://github.com/PixelAtLarge/the-lowdown#readme",
  "bugs": {
    "url": "https://github.com/PixelAtLarge/the-lowdown/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/styles.css": "./dist/react.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "the-lowdown": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/react.css dist/react.css && chmod +x dist/cli.js",
    "test": "npm run build && node --test dist/index.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test",
    "site:dev": "vite site",
    "site:build": "vite build site"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "publishConfig": {
    "access": "public"
  }
}
